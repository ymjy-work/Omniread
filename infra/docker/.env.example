# Omniread 环境变量模板
#
# 用途：本文件只登记「需要哪些变量、从哪来」，值是占位符，不是凭据。
# 真正的值一律由 keymgr 注入进程环境（红线）；
# .env 已被 .gitignore 忽略，任何真实凭据都不写进仓库文件。
#
# 用法：
#   keymgr 注入后，在 infra/docker 目录下执行 compose；
#   compose 会自动读取同目录的 .env（存在时）。
#   本文件是模板，复制成 .env 也请只放本地开发用途的临时值。

# ---- 基础设施：compose 从这里取值 ----

# PostgreSQL 超级用户与库名；不是凭据，可用默认值
POSTGRES_USER=omniread
POSTGRES_DB=omniread
# 由 keymgr 注入，compose 里标记为必填
POSTGRES_PASSWORD=<由 keymgr 注入>

# 本地对象存储（仅 compose 的 MinIO 容器用；应用侧统一用 OMNIREAD_OBJECT_STORE_*）
# access key 固定为 MinIO-Omniread；secret 走 keymgr 的 MinIO-Omniread 条目
MINIO_ROOT_USER=MinIO-Omniread
MINIO_SECRET_KEY=<由 keymgr 注入>
# 语料原始件归档桶
MINIO_BUCKET=omniread-sources
# 应用侧不在这里配置：本地由 dev-up.sh 把上面的容器凭据映射成
# OMNIREAD_OBJECT_STORE_*。**生产容器不要读 AWS_***——见下面「生产」一节。

# ---- 模型 Provider：不参与 compose，由 Python RAG 进程读取 ----
# 仅登记变量名，值一律经 keymgr 注入。

# 回答模型 GLM-5.3-Flash
GLM_API_KEY=<由 keymgr 注入>
# Embedding 与 Rerank 共用阿里云百炼
DASHSCOPE_API_KEY=<由 keymgr 注入>

# ---- 生产（docker-compose.app.yml 需要；应用侧通用名，不是 AWS_*） ----
# 本机开发用不到这一节；部署时由部署侧注入（方式待批）。
# 数据库：AWS RDS
POSTGRES_HOST=<RDS 端点>
POSTGRES_PORT=5432
POSTGRES_DB=omniread
POSTGRES_USER=<主用户名>
POSTGRES_PASSWORD=<由部署侧注入>
POSTGRES_SSLMODE=require
# 对象存储：AWS S3（单桶 + 前缀）
OMNIREAD_OBJECT_STORE_ENDPOINT=s3.<region>.amazonaws.com
OMNIREAD_OBJECT_STORE_REGION=<region>
OMNIREAD_OBJECT_STORE_BUCKET=<桶名>
OMNIREAD_OBJECT_STORE_PREFIX=omniread
OMNIREAD_OBJECT_STORE_SECURE=true
OMNIREAD_OBJECT_STORE_ACCESS_KEY=<由部署侧注入>
OMNIREAD_OBJECT_STORE_SECRET_KEY=<由部署侧注入>
# 改写与摘要用的模型
DEEPSEEK_API_KEY=<由部署侧注入>
# 前端构建期注入（Vite 内联，运行时传没用）：权利人联系方式
VITE_RIGHTS_CONTACT=<权利人联系方式>
