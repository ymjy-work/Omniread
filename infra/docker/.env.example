# Omniread M0 环境变量模板
#
# 用途：本文件只登记「需要哪些变量、从哪来」，值是占位符，不是凭据。
# 真正的值一律由 keymgr 注入进程环境（M0-00 §6 红线）；
# .env 已被 .gitignore 忽略，任何真实凭据都不写进仓库文件。
#
# 用法：
#   keymgr 注入后，在 infra/docker 目录下执行 compose；
#   compose 会自动读取同目录的 .env（存在时）。
#   本文件是模板，复制成 .env 也请只放本地开发用途的临时值。
#
# 变量清单与 keymgr 条目对照见 docs/m0/M0-01-技术方案.md §5.2。

# ---- 基础设施：compose 从这里取值 ----

# PostgreSQL 超级用户与库名；不是凭据，可用默认值
POSTGRES_USER=omniread
POSTGRES_DB=omniread
# 由 keymgr 注入，compose 里标记为必填
POSTGRES_PASSWORD=<由 keymgr 注入>

# MinIO access key 固定为 MinIO-Omniread；secret 走 keymgr 的 MinIO-Omniread 条目
MINIO_ROOT_USER=MinIO-Omniread
MINIO_SECRET_KEY=<由 keymgr 注入>
# 语料原始件归档桶（M0-02 §4）
MINIO_BUCKET=omniread-sources

# ---- 模型 Provider：不参与 compose，由 Python RAG 进程读取 ----
# 仅登记变量名，值一律经 keymgr 注入。

# 回答模型 GLM-5.3-Flash（keymgr 条目 glm-rag）
GLM_API_KEY=<由 keymgr 注入>
# Embedding 与 Rerank 共用阿里云百炼（keymgr 条目 ALiBaiLian）
DASHSCOPE_API_KEY=<由 keymgr 注入>
